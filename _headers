# _headers - HTTP Headers for GitHub Pages

# Default caching for all files
/*
  Cache-Control: public, max-age=3600

# HTML files - cache for 1 hour, revalidate
*.html
  Cache-Control: public, max-age=3600, must-revalidate

# CSS files - cache for 1 year
*.css
  Cache-Control: public, max-age=31536000, immutable

# JavaScript files - cache for 1 year
*.js
  Cache-Control: public, max-age=31536000, immutable

# Image files - cache for 1 year
*.png
  Cache-Control: public, max-age=31536000, immutable
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.jpeg
  Cache-Control: public, max-age=31536000, immutable
*.gif
  Cache-Control: public, max-age=31536000, immutable
*.webp
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable

# Font files - cache for 1 year
*.woff
  Cache-Control: public, max-age=31536000, immutable
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Important pages - no caching
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
/sitemap.xml
  Cache-Control: no-cache, no-store, must-revalidate
